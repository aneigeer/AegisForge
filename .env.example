# DBGuardian 环境变量模板
# 复制为 .env 后填入本机值；.env 不会进入 Git。
# 本机使用 Python 3.14.7、MySQL 8.0.x。

DG_ENV=dev
DG_APP_NAME=DBGuardian
DG_LOG_LEVEL=INFO
DG_LOG_JSON=true

# 被观察数据库标识（只读诊断目标）
DG_DATABASE_ID=lab_mysql_01

# 只读诊断账号：仅 SELECT，只读会话
DG_RO_DSN=mysql://dg_ro:CHANGE_ME_RO@127.0.0.1:3306/dg_lab?charset=utf8mb4
# 隔离沙箱写账号：仅 dg_lab 库的受控写权限，供故障注入/后续修复使用
DG_RW_DSN=mysql://dg_rw:CHANGE_ME_RW@127.0.0.1:3306/dg_lab?charset=utf8mb4
# 控制库独立账号：仅 dg_system（任务/事件/证据/审计）
DG_CONTROL_DSN=mysql://dg_ctl:CHANGE_ME_CONTROL@127.0.0.1:3306/dg_system?charset=utf8mb4

DG_CONNECT_TIMEOUT_S=5
DG_STATEMENT_TIMEOUT_MS=30000
DG_MAX_RESULT_ROWS=500

# PostgreSQL LAB（W01 双引擎；本地默认端口 55432）
# 只读账号只有 SELECT；写入账号仅用于隔离 LAB 实验。
DG_PG_DATABASE_ID=lab_pg_01
DG_PG_RO_DSN=postgresql://dg_ro_pg:CHANGE_ME_PG_RO@127.0.0.1:55432/dg_lab_pg?sslmode=disable
DG_PG_RW_DSN=postgresql://dg_rw_pg:CHANGE_ME_PG_RW@127.0.0.1:55432/dg_lab_pg?sslmode=disable

# ---------------------------------------------------------------------------
# Model Gateway（W04）
# 三态（同一时刻只启用一行）：
# fake：确定性桩适配器（无需外部服务，用于测试/本地演示）；
# openai_compat：OpenAI 兼容 HTTP 端点（需填写 DG_MODEL_BASE_URL / DG_MODEL_API_KEY）；
# disabled：模型服务不可用（W09 T05 降级路径）。装配期不再抛 ConfigError，
#   改为返回 DisabledModelGateway；模型调用抛 ModelUnavailableError，
#   Agent 规划暂停（ModelState.SUSPENDED / planning_suspended=True），
#   只允许基于既有证据生成降级规则简报，禁止新规划与工具选择
#   （实现见 core/models/factory.py 与 core/models/degradation.py）。
#   此态下模型侧指标一律未测得（BLOCKED_MODEL_ENV_MISSING），不填估计值。
# 模型服务不接收任何数据库凭据；此处只保存模型服务自己的密钥。
# 示例（注释状态，不启用）：
# DG_MODEL_PROVIDER=disabled
# ---------------------------------------------------------------------------
DG_MODEL_PROVIDER=fake
DG_MODEL_NAME=fake-diagnostic-1
DG_MODEL_BASE_URL=
DG_MODEL_API_KEY=
DG_MODEL_TIMEOUT_S=30
DG_MODEL_MAX_TOKENS=1024
# P1-T1 角色路由（JSON，未列出的角色回落 DG_MODEL_NAME）：
#   planner=旗舰模型（复杂 RCA），classifier=小模型（轻任务），evaluator=评估辅助。
#   embedding 暂不支持：当前只有 /chat/completions 传输，映射它会在装配期报 ConfigError。
#   仅 openai_compat 支持；provider=fake 时配置角色映射同样报错（单桩适配器无模型区分）。
# 示例（注释状态）：
# DG_MODEL_ROLE_MODELS={"planner":"qwen2.5-7b-instruct-baseline:latest","classifier":"qwen2.5-3b-instruct-q8_0-baseline:latest"}
# 结构化输出严格模式：下发目标 Pydantic 模型的 json_schema；端点不支持时置 false 退回 json_object。
DG_MODEL_USE_JSON_SCHEMA=true
# ---- P1-BYOK：租户级模型供应商 -------------------------------------------
# 主密钥（Fernet）：api_key 用它加密落库；未配置时 /v1/model-providers 返回 SECRET_KEY_MISSING。
# 至少 16 字符；轮换必须同时重加密既有密文（见 docs/migrations.md 与台账 §25）。
DG_SECRET_MASTER_KEY=
# SSRF：默认只允许 https；http 仅 dev 且主机在 allowlist 时放行（逗号分隔）。
DG_BYOK_ALLOW_HTTP=false
DG_BYOK_ALLOWED_HOSTS=
# 每租户配额（留空 = 不限）；触顶 fail-closed 并触发审计回调。
DG_BYOK_MAX_CALLS_PER_TASK=
DG_BYOK_MAX_TOKENS_PER_TASK=
# P3-T2：任务后知识沉淀（默认关闭）。开启后每次诊断生成一条 PROPOSED 草稿，
# 仍需两名不同的人完成两级确认才会进入检索面（不会自动晋升 INDEXED）。
DG_MEMORY_AUTO_DRAFT=false

# 计价（每 1K token，美元）。未配置 → 成本字段恒 null（不估算，INV-06）。
# DG_MODEL_INPUT_PRICE_PER_1K=0.0
# DG_MODEL_OUTPUT_PRICE_PER_1K=0.0

# Agent Loop 预算与轨迹
DG_TRAJECTORY_DIR=runs
DG_AGENT_MAX_STEPS=8
DG_AGENT_MAX_TOOL_CALLS=10
DG_AGENT_MAX_MODEL_CALLS=20
DG_AGENT_MAX_TOKENS=20000
DG_AGENT_MAX_SECONDS=300
DG_AGENT_MAX_DUPLICATE_CALLS=2
DG_AGENT_NO_PROGRESS_THRESHOLD=2

# ---------------------------------------------------------------------------
# W05 身份认证与策略底座
# dev_local：仅开发/测试的服务端本地主体，生产环境会被配置校验拒绝；
# token：本地账户登录后使用 Bearer Token，生产必须使用。
# DG_GATEWAY_SIGNING_KEY 生产必填；开发留空时使用进程内临时密钥（多进程不共享）。
# ---------------------------------------------------------------------------
DG_AUTH_MODE=dev_local
DG_AUTH_TOKEN_TTL_S=3600
DG_AUTH_TOKEN_MAX_TTL_S=86400
# Gateway 执行信封 HMAC 密钥。
# dev 下留空表示"进程内随机密钥"：Worker 与 ToolGateway 在同进程时可用，
# 但**拆容器/多进程时必须显式配置同一个值**，否则验签必败（NONCE/签名校验失败）。
DG_GATEWAY_SIGNING_KEY=CHANGE_ME
DG_GATEWAY_ENVELOPE_TTL_S=60
DG_WORKER_LEASE_TTL_S=30
DG_WORKER_HEARTBEAT_INTERVAL_S=10
DG_POLICY_VERSION=w06-v1

# ---------------------------------------------------------------------------
# W07 收口：独立 Worker 载体（python -m workers）
# DG_WORKER_ID 多副本部署时必须全局唯一（租约归属 + 审计标注）；
# DG_WORKER_SHUTDOWN_GRACE_S 必须 >= 单次工具 timeout（写工具 5s），
# 否则优雅停机可能在写到一半时切断连接，制造未知结果；
# DG_WORKER_MAX_CONCURRENCY 本轮固定为 1（配置层 ge=1 le=1）。
# ---------------------------------------------------------------------------
DG_WORKER_ID=worker_local_01
DG_WORKER_POLL_INTERVAL_S=5
DG_WORKER_SHUTDOWN_GRACE_S=30
DG_WORKER_MAX_CONCURRENCY=1
DG_WORKER_ACTOR_USER_ID=system:worker

# ---------------------------------------------------------------------------
# 仅初始化脚本使用；应用进程不需要管理员凭据。
# 不要把真实密码写进 .env.example 或 Git。
# ---------------------------------------------------------------------------
DG_ADMIN_DSN=mysql://root:CHANGE_ME@127.0.0.1:3306/mysql?charset=utf8mb4
DG_RO_PASSWORD=CHANGE_ME_RO
DG_RW_PASSWORD=CHANGE_ME_RW
DG_CONTROL_PASSWORD=CHANGE_ME_CONTROL

# PostgreSQL LAB 初始化专用（仅 bootstrap 脚本使用，应用进程不读取）
DG_PG_ADMIN_DSN=postgresql://dg_admin:CHANGE_ME_PG_ADMIN@127.0.0.1:55432/postgres?sslmode=disable
DG_PG_RO_PASSWORD=CHANGE_ME_PG_RO
DG_PG_RW_PASSWORD=CHANGE_ME_PG_RW

# Docker Compose 专用（本机已有 MySQL 时无需使用）
DG_MYSQL_PORT=3307
DG_MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
